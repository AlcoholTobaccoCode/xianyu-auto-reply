# ============================================================
# WebSocket 本地开发配置模板
#
# 用法：
#   cp .env.dev .env
#   docker compose -f ../docker-compose.dev.yml up -d
#   cd websocket && ../.venv/bin/python main.py
#
# 必须在 websocket/ 目录下启动，.env 才会被正确读取。
#
# 首次启动前先让 backend-web 启动过一次，以便从数据库加载内部 API token。
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
HOST=127.0.0.1

# ---- MySQL（docker-compose.dev.yml 默认映射 3307）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=xianyu
MYSQL_PASSWORD=xianyu_dev_2026
MYSQL_DATABASE=xianyu_data

# ---- Redis（docker-compose.dev.yml 默认映射 6380）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=redis_dev_2026
REDIS_DB=0
REDIS_POOL_SIZE=600
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3
REDIS_STARTUP_MAX_RETRIES=5
REDIS_STARTUP_RETRY_BASE_DELAY=1
REDIS_STARTUP_RETRY_CAP_DELAY=10

# ---- WebSocket 服务 ----
# 本机 8090 已被 nginx 占用，dev 环境改用 18090
WEBSOCKET_PORT=18090
# 本地开发默认不自动连接所有已登录闲鱼账号，避免一启动就发请求
AUTO_START_WEBSOCKET=false

# ---- 浏览器与验证码 ----
MAX_CAPTCHA_CONCURRENT=1
BROWSER_HEADLESS=true
CAPTCHA_DRISSIONPAGE_FALLBACK_ENABLED=false
CAPTCHA_DRISSIONPAGE_TIMEOUT=25
CAPTCHA_DRISSIONPAGE_HEADLESS=true

# ---- Token 刷新（秒）----
TOKEN_REFRESH_INTERVAL=72000
TOKEN_RETRY_INTERVAL=7200

# ---- 服务间通信 ----
BACKEND_WEB_SERVICE_URL=http://127.0.0.1:8089
# 留空时首次启动自动生成并写入数据库
INTERNAL_API_TOKEN=

# ---- 路径 ----
# 相对于 websocket/ 目录，指向 backend-web/static，保持静态资源共用
STATIC_DIR=../backend-web/static

# ---- 连接池（本地调小；dev MySQL 的 max_connections=2500）----
DB_POOL_SIZE=600
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT=10
