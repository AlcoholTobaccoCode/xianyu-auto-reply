# ============================================================
# Scheduler 本地开发配置模板
#
# 用法：
#   cp .env.dev .env
#   docker compose -f ../docker-compose.yml -f ../docker-compose.dev.yml up -d mysql redis
#   cd scheduler && ../.venv/bin/python main.py
#
# 必须在 scheduler/ 目录下启动，.env 才会被正确读取。
#
# 首次启动前先让 backend-web 启动过一次，以便从数据库加载内部 API token。
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
HOST=127.0.0.1

# ---- MySQL（docker-compose.dev.yml 默认映射 3307）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=xianyu
MYSQL_PASSWORD=xianyu@2026
MYSQL_DATABASE=xianyu_data

# ---- Redis（docker-compose.dev.yml 默认映射 6380）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=xianyu@2026
REDIS_DB=0
REDIS_POOL_SIZE=600
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3
REDIS_STARTUP_MAX_RETRIES=5
REDIS_STARTUP_RETRY_BASE_DELAY=1
REDIS_STARTUP_RETRY_CAP_DELAY=10

# ---- Scheduler 服务 ----
SCHEDULER_PORT=8091
REDELIVERY_INTERVAL=5
RATE_INTERVAL=20

# ---- 服务间通信 ----
# 与 websocket/.env.dev 的 WEBSOCKET_PORT 保持一致
WEBSOCKET_SERVICE_URL=http://127.0.0.1:18090
BACKEND_WEB_SERVICE_URL=http://127.0.0.1:8089
# 留空时首次启动自动生成并写入数据库
INTERNAL_API_TOKEN=

# ---- 路径 ----
# 相对于 scheduler/ 目录，指向 backend-web/static，保持静态资源共用
STATIC_DIR=../backend-web/static
# 相对服务目录，实际指向仓库根目录的 backups/，和 backend-web 共用
BACKUP_DIR=../backups

# ---- 连接池（本地调小；dev MySQL 的 max_connections=2500）----
DB_POOL_SIZE=600
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT=10
