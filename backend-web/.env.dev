# ============================================================
# Backend-Web 本地开发配置模板
#
# 用法：
#   cp .env.dev .env
#   docker compose -f ../docker-compose.dev.yml up -d
#   cd backend-web && ../.venv/bin/python main.py
#
# 必须在 backend-web/ 目录下启动，.env 才会被正确读取。
#
# 首次启动顺序：backend-web -> websocket -> scheduler
# backend-web 首次启动会生成内部 API token 并写入数据库。
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
HOST=127.0.0.1

# ---- MySQL（docker-compose.dev.yml 默认映射 3307）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=xianyu
MYSQL_PASSWORD=xianyu_dev_2026
MYSQL_DATABASE=xianyu_data

# ---- Redis（docker-compose.dev.yml 默认映射 6380）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=redis_dev_2026
REDIS_DB=0
REDIS_POOL_SIZE=600
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3
REDIS_STARTUP_MAX_RETRIES=5
REDIS_STARTUP_RETRY_BASE_DELAY=1
REDIS_STARTUP_RETRY_CAP_DELAY=10

# ---- 服务端口与认证 ----
BACKEND_WEB_PORT=8089
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# 留空时首次启动自动生成并写入数据库
INTERNAL_API_TOKEN=
CORS_ORIGINS=*

# 本机 8090 已被 nginx 占用，dev 环境改用 18090。
# 换端口时同步修改 websocket/.env.dev 和 scheduler/.env.dev 里的 WEBSOCKET_SERVICE_URL。
WEBSOCKET_SERVICE_URL=http://127.0.0.1:18090
SCHEDULER_SERVICE_URL=http://127.0.0.1:8091

# ---- 本地开发默认不请求作者的官方服务 ----
# 分销卡券要联调时，把 CARD_DOCK_BASE_URL 改成你自己的上游或本地 mock
CARD_DOCK_BASE_URL=http://backend.zhinianboke.com
EXTERNAL_API_KEY=dev_external_key
REMOTE_OFFICIAL_BASE_URL=https://xy.zhinianboke.com
ENABLE_REMOTE_ADS=false
ENABLE_REMOTE_ANNOUNCEMENTS=false
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=false
AUTO_START_CRAWL_JOBS=false

# ---- 路径 ----
# backend-web/static 作为本地共享静态目录；websocket/scheduler 的模板都指向这里
STATIC_DIR=static
# 相对服务目录，实际指向仓库根目录的 backups/
BACKUP_DIR=../backups
FRONTEND_PUBLIC_URL=http://127.0.0.1:9000
BACKEND_WEB_PUBLIC_URL=http://127.0.0.1:8089

# ---- 连接池（本地调小；dev MySQL 的 max_connections=2500）----
DB_POOL_SIZE=600
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT=10
